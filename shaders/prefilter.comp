// The environment blurred for one roughness, by importance sampling the GGX lobe.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform samplerCube uEnvironment;
layout(binding = 0, rgba16f) uniform writeonly imageCube uOutput;

uniform float uRoughness;
uniform float uSourceSize;

void main()
{
    ivec3 texel = ivec3(gl_GlobalInvocationID);
    int size = imageSize(uOutput).x;
    if (texel.x >= size || texel.y >= size)
        return;
    vec3 n = CubeDirection(texel, float(size));
    if (uRoughness <= 0.0) {
        imageStore(uOutput, texel, vec4(textureLod(uEnvironment, n, 0.0).rgb, 1.0));
        return;
    }

    mat3 frame = TangentFrame(n);
    const uint Count = 512u;
    float texelSolidAngle = 4.0 * PI / (6.0 * uSourceSize * uSourceSize);
    vec3 sum = vec3(0.0);
    float weights = 0.0;
    for (uint i = 0u; i < Count; ++i) {
        vec3 h = frame * ImportanceSampleGgx(Hammersley(i, Count), uRoughness);
        vec3 l = reflect(-n, h);
        float NoL = dot(n, l);
        if (NoL <= 0.0)
            continue;
        // Sparse samples read a blurrier level, so bright spots spread instead of sparkling.
        float NoH = max(dot(n, h), 0.0);
        float pdf = DistributionGgx(NoH, uRoughness) * 0.25 + 1e-4;
        float sampleSolidAngle = 1.0 / (float(Count) * pdf);
        float lod = max(0.5 * log2(sampleSolidAngle / texelSolidAngle) + 1.0, 0.0);
        sum += textureLod(uEnvironment, l, lod).rgb * NoL;
        weights += NoL;
    }
    imageStore(uOutput, texel, vec4(sum / max(weights, 1e-4), 1.0));
}
