// The light falling on a matte surface facing each direction: the environment averaged over a cosine.

layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;

layout(binding = 0) uniform samplerCube uEnvironment;
layout(binding = 0, rgba16f) uniform writeonly imageCube uOutput;

uniform float uSourceLod;

void main()
{
    ivec3 texel = ivec3(gl_GlobalInvocationID);
    int size = imageSize(uOutput).x;
    if (texel.x >= size || texel.y >= size)
        return;
    vec3 n = CubeDirection(texel, float(size));
    mat3 frame = TangentFrame(n);
    const uint Count = 1024u;
    vec3 sum = vec3(0.0);
    for (uint i = 0u; i < Count; ++i) {
        vec2 xi = Hammersley(i, Count);
        float phi = 2.0 * PI * xi.x;
        float cosTheta = sqrt(1.0 - xi.y);
        float sinTheta = sqrt(xi.y);
        vec3 direction = frame * vec3(sinTheta * cos(phi), sinTheta * sin(phi), cosTheta);
        sum += textureLod(uEnvironment, direction, uSourceLod).rgb;
    }
    imageStore(uOutput, texel, vec4(sum / float(Count), 1.0));
}
